      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "Render loop:  scene.update_frame(dt=0) \u2192 FBO readback \u2192 upright RGBA \u2192 FramePump.offer() \u2192 encode_frame() \u2192 frames channel \u2192 PreviewPanel QImage.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Render loop:  scene.update_frame(dt=0) \u2192 FBO readback \u2192 upright RGBA \u2192 FramePump.offer() \u2192 encode_frame() \u2192 frames channel \u2192 PreviewPanel QImage.",
      "lineHeight": 1.25
    },
    {
      "id": "label72",
      "type": "text",
      "x": 170,
      "y": 2552,
      "width": 1836.0,
      "height": 21.25,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
