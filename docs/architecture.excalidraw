      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1072,
      "version": 1,
      "versionNonce": 1072,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "Scrub:  filmstrip hit = instant (no GL); miss = ScrubEngine.pose(time) then cache the result.  Edits:  apply_patches() runs the same source in preview, scrub, filmstrip and export.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Scrub:  filmstrip hit = instant (no GL); miss = ScrubEngine.pose(time) then cache the result.  Edits:  apply_patches() runs the same source in preview, scrub, filmstrip and export.",
      "lineHeight": 1.25
    },
