      "boundElements": [],
      "updated": 1791664924458,
      "link": null,
      "locked": false,
      "text": "control channel — newline-delimited JSON, both ways\nhello{channel, protocol=5} handshake\n→ commands: load · reload · play · stop · seek · scrub · resize\n                  exec · ping · stats · set_patches · quit\n← events:   log · status · tick · stopped · error\n                  exec_result · filmstrip · stats · pong\nbackpressure: one in flight, newest wins",
      "fontSize": 28,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rect30",
      "originalText": "control channel — newline-delimited JSON, both ways\nhello{channel, protocol=5} handshake\n→ commands: load · reload · play · stop · seek · scrub · resize\n                  exec · ping · stats · set_patches · quit\n← events:   log · status · tick · stopped · error\n                  exec_result · filmstrip · stats · pong\nbackpressure: one in flight, newest wins",
      "lineHeight": 1.25,
      "index": "aU",
      "frameId": null,
