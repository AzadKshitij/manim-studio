      "versionNonce": 1033,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "frames channel \u2014 binary, host \u2192 editor\n(embedded mode only)\nheader <4sBIIQ>:\n  magic 'MFRM' \u00b7 scheme(0 zlib/1 zstd/2 raw)\n  width \u00b7 height \u00b7 payload_len\n+ upright RGBA8888 payload\ndrops frames instead of queueing",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rect32",
      "originalText": "frames channel \u2014 binary, host \u2192 editor\n(embedded mode only)\nheader <4sBIIQ>:\n  magic 'MFRM' \u00b7 scheme(0 zlib/1 zstd/2 raw)\n  width \u00b7 height \u00b7 payload_len\n+ upright RGBA8888 payload\ndrops frames instead of queueing",
      "lineHeight": 1.25
    },
