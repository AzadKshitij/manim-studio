      "boundElements": [],
      "updated": 1791664924458,
      "link": null,
      "locked": false,
      "text": "frames channel — binary, host → editor\n(embedded mode only)\nheader <4sBIIQ>:\n  magic 'MFRM' · scheme(0 zlib/1 zstd/2 raw)\n  width · height · payload_len\n+ upright RGBA8888 payload\ndrops frames instead of queueing",
      "fontSize": 28,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rect32",
      "originalText": "frames channel — binary, host → editor\n(embedded mode only)\nheader <4sBIIQ>:\n  magic 'MFRM' · scheme(0 zlib/1 zstd/2 raw)\n  width · height · payload_len\n+ upright RGBA8888 payload\ndrops frames instead of queueing",
      "lineHeight": 1.25,
      "index": "aW",
      "frameId": null,
      "created": null,
