      "updated": 1791664924461,
      "link": null,
      "locked": false,
      "text": "Render loop:  scene.update_frame(dt=0) → FBO readback → upright RGBA → FramePump.offer() → encode_frame() → frames channel → PreviewPanel QImage.",
      "fontSize": 28,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Render loop:  scene.update_frame(dt=0) → FBO readback → upright RGBA → FramePump.offer() → encode_frame() → frames channel → PreviewPanel QImage.",
      "lineHeight": 1.25,
      "index": "b08",
      "frameId": null,
      "created": null,
      "autoResize": true,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
