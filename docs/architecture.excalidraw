    {
      "id": "text35",
      "type": "text",
      "x": 1570,
      "y": 1178,
      "width": 580,
      "height": 120.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "roundness": null,
      "seed": 1035,
      "version": 1,
      "versionNonce": 1035,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1700000000000,
      "link": null,
      "locked": false,
      "text": "lifecycle & handshake\nhost retries connect for 15 s\ngraceful quit, else kill after 3 s\nwatchdog exits host if editor dies\neditor restarts host on next reload\nPROTOCOL_VERSION guards both sides",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rect34",
      "originalText": "lifecycle & handshake\nhost retries connect for 15 s\ngraceful quit, else kill after 3 s\nwatchdog exits host if editor dies\neditor restarts host on next reload\nPROTOCOL_VERSION guards both sides",
      "lineHeight": 1.25
    },
