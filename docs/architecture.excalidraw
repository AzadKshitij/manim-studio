    {
      "id": "text33",
      "type": "text",
      "x": 2270,
      "y": 1178,
      "width": 660,
      "height": 148.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
